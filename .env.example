# ==============================================================================
# MedioMeteo Genova — Configurazione Ambiente (.env.example)
# Copia questo file in `.env` e inserisci le tue chiavi opzionali.
# NOTA: Il sistema funziona al 100% anche senza chiavi commerciali grazie allo
# stack scientifico Open-Meteo Multi-Model (AROME, ICON-D2, ECMWF, GFS, Marine)
# + RainViewer Radar + Allerta Liguria / Meteomar + Fallback Sinottico Esperto.
# ==============================================================================

# --- AI Meteo & Marine Advisor (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Provider Meteo & Marine Commerciali Opzionali ---
TOMORROW_API_KEY=
WEATHERAPI_KEY=
STORMGLASS_API_KEY=
WINDY_API_KEY=

# --- Parametri Server & Cache ---
MEDIOMETEO_DB_PATH=data/mediometeo.sqlite
NOWCAST_TTL_SECONDS=180
FORECAST_TTL_SECONDS=1800
AI_BULLETIN_TTL_SECONDS=900
HTTP_TIMEOUT_SECONDS=6.0
